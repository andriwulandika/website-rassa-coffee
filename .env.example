# Password untuk role owner - akses penuh: Kasir, Laporan, Kelola Menu
ADMIN_PASSWORD=

# Password untuk role kasir - akses cuma ke halaman Kasir (POS)
KASIR_PASSWORD=

# Supabase - dari Project Settings > API di dashboard Supabase
# Project URL, contoh: https://xxxxxxxx.supabase.co
SUPABASE_URL=
# service_role key (rahasia, JANGAN pernah pakai prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
